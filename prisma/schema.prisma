generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  sections      Section[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  
  access_token       String?  
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Section {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  title          String
  theme          String              // "travel" | "event" | "everyday" | custom
  layoutType     String              // "filmstrip" | "polaroid" | "mosaic"
  backgroundUrl  String?
  customCssUrl   String?
  isPublic       Boolean  @default(false)
  shareSlug      String?  @unique
  images         Image[]
  createdAt      DateTime @default(now())
}

model Image {
  id           String   @id @default(cuid())
  sectionId    String
  section      Section  @relation(fields: [sectionId], references: [id])
  originalUrl  String              // full HD, R2 key
  displayUrl   String              // ~1600px WebP, used for normal viewing
  thumbUrl     String              // ~400px WebP, used in grids
  takenAt      DateTime?           // from EXIF
  uploadedAt   DateTime @default(now())
  width        Int
  height       Int
  position     Int      @default(0)
  notes        Note[]
}

model Note {
  id       String  @id @default(cuid())
  imageId  String
  image    Image   @relation(fields: [imageId], references: [id])
  text     String
  x        Float              // percentage position, 0-100
  y        Float
  color    String  @default("#D9A339")
}
